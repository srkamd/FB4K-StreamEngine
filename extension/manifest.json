{
  "manifest_version": 3,
  "name": "FB4KDownloader — 4K Facebook Reel & Video Downloader",
  "version": "2.1.1",
  "description": "Download Facebook Reels and videos in 4K Ultra HD, 1080p, and MP3 audio directly with 1-click on-reel icons.",
  "permissions": [
    "activeTab",
    "downloads",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.fbcdn.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB4KDownloader — 1-Click Facebook Reel Downloader",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
